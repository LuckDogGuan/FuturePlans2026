    {
      "start": 361.43,
      "end": 363.57,
      "text": "诶并且你做你可以自己搭配"
    },
    {
      "start": 363.57,
      "end": 367.97,
      "text": "完全不会受他的那些那些就商业协议的影响"
    },
    {
      "start": 367.97,
      "end": 370.94,
      "text": "其次做这个事情的人特别多"
    },
    {
      "start": 370.94,
      "end": 371.7,
      "text": "他有个什么好处呢"
    },
    {
      "start": 371.7,
      "end": 373.46,
      "text": "这两年投身rise five这些"
    },
    {
      "start": 373.46,
      "end": 375.74,
      "text": "他有点像当年的那个LINUX一样"
    },
    {
      "start": 375.74,
      "end": 378.12,
      "text": "很多人去去去玩"
